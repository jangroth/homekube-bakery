{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "customManagers:dockerfileVersions"],
  "automerge": true,
  "automergeType": "pr",
  "customManagers": [
    {
      "customType": "regex",
      "description": "README tracked dependency rows, so they move with the Dockerfile bump",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["\\| `(?<depName>anomalyco/opencode|cli/cli|coder/coder)` \\| `(?<currentValue>[^`]+)` \\|"],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "README tracked dependency rows, so they move with the Dockerfile bump",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["\\| `(?<depName>nousresearch/hermes-agent)` \\| `(?<currentValue>[^`]+)` \\|"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["anomalyco/opencode", "cli/cli", "coder/coder"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "matchDepNames": ["nousresearch/hermes-agent"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": ["nousresearch/hermes-agent"],
      "matchCurrentVersion": "/^v0\\./",
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
